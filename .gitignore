# 公開を許可したファイルだけをGit管理する
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/style.css
!/categories.js
!/core.js
!/app.js
!/pwa.js
!/sw.js
!/manifest.webmanifest
!/icons/
/icons/*
!/icons/apple-touch-icon.png
!/icons/icon-192.png
!/icons/icon-512.png
!/icons/hitoiki-icon-180.png
!/icons/hitoiki-icon-192.png
!/icons/hitoiki-icon-512.png
!/icons/hitoiki-icon-v2-180.png
!/icons/hitoiki-icon-v2-192.png
!/icons/hitoiki-icon-v2-512.png
!/assets/
/assets/*
!/assets/bear-bird-timer.png
!/assets/bear-bird-timer-v2.png
!/assets/bear-bird-timer-v3.png
